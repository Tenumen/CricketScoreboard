[Unit]
Description=Aston on Trent VCC scoreboard24
# NOTE: deliberately NOT ordered after network-online.target. The scoreboard
# only ever talks to the BLE bridge over localhost (127.0.0.1), so waiting for
# the LAN/WiFi to be "online" added ~10s of dead boot time. Starting as soon as
# basic.target is up lights the panel ~10s sooner. See scripts/install_pi.sh.

[Service]
Type=simple
User=root
WorkingDirectory=/home/tenumen/scoreboard24
ExecStart=/home/tenumen/scoreboard24/scoreboard24
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

# KillMode=process: when systemd stops/restarts this service, only the main
# scoreboard24 process gets SIGTERM. Any helper processes (e.g. the update
# script spawned from the HTTP debug server) survive in their own process
# tree and finish cleanly.
KillMode=process

# Shutdown mailer (optional): ExecStopPost runs after the main process exits
# regardless of exit code, so it covers manual stop, crash, admin-console
# shutdown, and OS poweroff. TimeoutStopSec gives the mailer's 20 s SMTP
# attempt a 45 s enclosing budget.
#
# The encrypted credential is deliberately NOT required here. install_pi.sh adds
# LoadCredentialEncrypted= via a drop-in (scoreboard24.service.d/) ONLY when
# /etc/credstore.encrypted/scoreboard24-mailer.cred exists. Without it,
# shutdown_mailer.py exits 0 (no-op), so the board always boots even before the
# mailer is provisioned. A hard LoadCredentialEncrypted= here once crash-looped
# the board on a fresh cold boot (exit 243/CREDENTIALS, incident 2026-06-09):
# systemd aborts at step CREDENTIALS before ExecStart if the cred is missing.
# See scripts/setup_mailer_creds.md.
ExecStopPost=/usr/bin/python3 /home/tenumen/scoreboard24/scripts/shutdown_mailer.py
TimeoutStopSec=45s

[Install]
WantedBy=multi-user.target
