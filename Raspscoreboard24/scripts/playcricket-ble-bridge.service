[Unit]
Description=Play-Cricket Scorer BLE bridge (Pixel 9a -> scoreboard24)
# Needs bluetooth (BLE peripheral mode) but NOT network-online: data arrives
# over BLE and is served only on 127.0.0.1, so there are zero outbound calls.
# Dropping the network-online wait removes ~10s from boot. See install_pi.sh.
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
User=tenumen
Group=tenumen
WorkingDirectory=/home/tenumen/playcricket_ble_bridge
ExecStart=/home/tenumen/playcricket_ble_bridge/run.sh --host 127.0.0.1 --port 5051
Restart=on-failure
RestartSec=5
# BLE peripheral mode needs the BLUETOOTH capability; user is in bluetooth group.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
